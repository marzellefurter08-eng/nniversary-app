{
  "name": "anniversary-connection",
  "version": "1.0.0",
  "description": "A stunning 1-month anniversary app for long-distance couples",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "framer-motion": "^10.16.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.0",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "tar": "^7.0.0",
    "glob": "^11.0.0",
    "extract-zip": "^2.0.1",
    "esbuild": "^0.24.0",
    "builder-util-runtime": "^9.7.0"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.anniversary.connection",
    "productName": "Anniversary Connection",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron.cjs"
    ],
    "win": {
      "target": ["portable"],
      "icon": "assets/icon.ico"
    }
  }
}
